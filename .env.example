# =====================================================================
# AI Bike Shop OS — Environment Variables
# =====================================================================
# Copy this file to .env (local dev) or set these in your deployment
# platform's environment variables dashboard.
#
# STORAGE ARCHITECTURE (permanent data persistence):
#   Database:  PostgreSQL (Neon for production, local for dev)
#   Images:    Cloudinary (CDN, for production) or local filesystem (dev)
#
# SQLite has been REMOVED. The app uses PostgreSQL exclusively so that
# data survives restarts and redeploys.
#
# Deploy guides:
#   Vercel + Neon + Cloudinary:  VERCEL-DEPLOY.md  (recommended, 100% free)
#   Railway + local uploads:     RAILWAY-DEPLOY.md
#   Render + local uploads:      RENDER-DEPLOY.md
# =====================================================================

# ---- DATABASE (REQUIRED) ----
# PostgreSQL connection string.
#
# LOCAL DEV (sandbox):
#   1. Run:  bash scripts/ensure-postgres.sh  (starts portable PG, no sudo)
#   2. Then use this URL:
DATABASE_URL=postgresql://postgres@localhost:5433/bikeshop
#
# PRODUCTION (Neon — free 0.5 GB, serverless PostgreSQL):
#   1. Sign up at https://neon.tech (free, GitHub login)
#   2. Create a project → copy the connection string
#   DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/bikeshop?sslmode=require
#
# PRODUCTION (Railway / Render — managed PostgreSQL):
#   Use the platform's provided DATABASE_URL (with ?sslmode=require if needed).

# ---- SESSION SECRET (REQUIRED for production) ----
# Used to sign authentication cookies. Generate a random string:
#   openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-string

# ---- NODE ENV ----
NODE_ENV=development

# ---- FILE UPLOADS: Cloudinary (REQUIRED for Vercel, optional elsewhere) ----
# Vercel has a read-only filesystem → Cloudinary is REQUIRED for uploads.
# Railway/Render/local have writable disks → Cloudinary is optional.
# Get a free account at https://cloudinary.com (25 credits/month free):
#   Dashboard → Settings → API Keys
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ---- AI FEATURES (OPTIONAL but recommended) ----
# The app works WITHOUT any AI key (local fallback mode handles chat,
# search, and insights using shop data + simple rules). To enable
# SMARTER AI features, set ONE of these env vars:
#
# OPTION A — Groq (RECOMMENDED, fastest, easiest signup)
#   1. Go to https://console.groq.com/keys
#   2. Sign in with Google or GitHub (instant, no credit card)
#   3. Click "Create API Key"
#   4. Free tier: 30 req/min, 14000/day — plenty for a small shop
#   5. On Vercel: Settings → Environment Variables → add:
#        GROQ_API_KEY = gsk_...
#   6. Redeploy
#   Note: Groq is text-only (no vision). For photo scan/OCR, use Gemini.
GROQ_API_KEY=
#
# OPTION B — Google Gemini (supports text + vision + audio)
#   1. Go to https://aistudio.google.com/app/apikey
#   2. Sign in with any Google account, click "Create API Key"
#   3. Free tier: 15 requests/min, 1500/day
#   4. Copy the key (starts with "AIza...")
#   5. On Vercel: Settings → Environment Variables → add:
#        GOOGLE_GENERATED_AI_API_KEY = AIza...
#   6. Redeploy
GOOGLE_GENERATED_AI_API_KEY=
#
# OPTION C — Z.ai SDK (only works in the Z.ai dev sandbox)
#   Auto-detected via /etc/.z-ai-config — no env vars needed.
#   For self-hosted Z.ai deployments, set:
# ZAI_API_KEY=your-api-key-here
# ZAI_BASE_URL=https://api.z.ai/v1
# ZAI_TOKEN=your-session-token
#
# PROVIDER PRIORITY: Gemini > Groq > Z.ai > Local Fallback
# Vision features (photo scan, OCR) need Gemini or Z.ai.
# Text features (chat, search, insights) work with ANY provider.

# ---- DATA MIGRATION (one-time, SQLite → PostgreSQL) ----
# If you have existing data in an old SQLite DB, run:
#   SQLITE_PATH=./db/custom.db bun run scripts/migrate-sqlite-to-postgres.ts
# This reads SQLite (via bun:sqlite) and writes to PostgreSQL (via Prisma).
# See scripts/migrate-sqlite-to-postgres.ts for details.
